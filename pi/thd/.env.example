# Pick whichever backend this device targets:
# API_URL=https://weather-station-project-production.up.railway.app/readings   # Railway remote deployment
# API_URL=http://192.168.1.100:8000/readings    # Local network deployment (Raspberry Pi LAN IP/port)
API_URL=https://weather-station-project-production.up.railway.app/readings
STATION_NAME=akkar-weather-station
SAMPLE_INTERVAL_SECONDS=30

# Autonics THD-WD1-T (RS485/Modbus RTU)
# Use a separate USB-to-RS485 adapter/port than the Linovision sensor if
# both are connected to the same Pi at once.
MODBUS_PORT=/dev/ttyUSB1
MODBUS_BAUDRATE=9600
MODBUS_PARITY=N
# Factory default address is 1 (upper address terminal OPEN, SW1=1) -- set
# via the rotary switch/terminal under the case cover, not over the wire.
# If both sensors ever share the same RS485 bus (not separate ports), one
# of them must be reassigned to a different address -- Modbus requires
# unique addresses per device on a shared bus.
MODBUS_SLAVE_ID=1
