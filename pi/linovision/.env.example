# Pick whichever backend this device targets:
# API_URL=https://weather-station-project-production.up.railway.app/readings   # Railway remote deployment
# API_URL=http://192.168.1.100:8000/readings    # Local network deployment (Raspberry Pi LAN IP/port)
API_URL=https://weather-station-project-production.up.railway.app/readings
STATION_NAME=akkar-weather-station
SAMPLE_INTERVAL_SECONDS=5

# Linovision 8-in-1 (RS485/Modbus RTU)
MODBUS_PORT=/dev/ttyUSB0
MODBUS_BAUDRATE=9600
MODBUS_PARITY=N
# Manual's per-model default-address table lists S800 (8-in-1) as 46, not the
# generic default of 1 -- confirm the real address on the device (USB config
# tool, or ASCII command 0XA;MBAD=?) before trusting this value.
MODBUS_SLAVE_ID=1
